# ServiceLoop environment.
#
# Copy to `.env` and adjust. Every variable is parsed and frozen at boot by
# `packages/config/src/env.ts`; an invalid value fails the boot with a
# field-scoped error rather than surfacing later as a mystery.
#
# Defaults are DEMO_MODE defaults: with an empty .env the whole system runs on
# sandbox adapters against the docker-compose stack.

# ─────────────────────────────── runtime ───────────────────────────────
NODE_ENV=development
# Forces every sandbox adapter, seeds the demo shop, enables the console's
# Sandbox Simulator. Must be false in production (enforced by the schema).
DEMO_MODE=true
SERVICE_NAME=serviceloop
APP_VERSION=0.1.0
LOG_LEVEL=info

# ─────────────────────────── docker-compose ports ───────────────────────
# Only needed when a host port is already taken (e.g. a locally installed
# Postgres on 5432). Keep DATABASE_URL/REDIS_URL/S3_ENDPOINT in sync.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ────────────────────────────── datastores ─────────────────────────────
DATABASE_URL=postgres://serviceloop:serviceloop@localhost:5432/serviceloop
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
REDIS_URL=redis://localhost:6379

# ──────────────────────────────── services ─────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001
CONSOLE_URL=http://localhost:3000
WORKERS_METRICS_PORT=9101

# ───────────────────────────────── auth ────────────────────────────────
# Minimum 32 characters. The development placeholder is rejected in production.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ───────────────────────── PII encryption (DPDP) ───────────────────────
# base64-encoded 32-byte keys. PII_KEY_ID names the active key; ciphertext
# records the key it was written with, so rotation is a background re-encrypt.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
PII_KEY_ID=dev-1
# Separate key for the deterministic blind index used to look customers up.
BLIND_INDEX_KEY=CwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCws=

# ─────────────────────────────── storage ───────────────────────────────
# memory = sandbox, s3 = MinIO/S3-compatible, gcs = native GCS (phase 7)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=serviceloop
S3_SECRET_ACCESS_KEY=serviceloop
S3_BUCKET=serviceloop-media
S3_FORCE_PATH_STYLE=true
#GCS_BUCKET=
#GCS_PROJECT_ID=

# ────────────────────────────── notifier ───────────────────────────────
# log = print the OTP to the process log (dev), memory = capture, sms = provider
NOTIFIER_DRIVER=log
#SMS_PROVIDER_API_KEY=

# ──────────────────────────────── LLM ──────────────────────────────────
# Model ids are configuration, never hardcoded (master §10), and they are
# chosen per *task class* rather than per call site: a caller asks for AGENT or
# JUDGE work and the adapter resolves the id.
#ANTHROPIC_API_KEY=
LLM_AGENT_MODEL=claude-sonnet-5
LLM_CLASSIFY_MODEL=claude-haiku-4-5-20251001
# EXTRACT covers every typed-document read, including a photographed job card.
LLM_EXTRACT_MODEL=claude-sonnet-5
LLM_JUDGE_MODEL=claude-haiku-4-5-20251001

# Sampling temperature per task class. Leave unset to send no temperature at
# all, which is the one request shape every current model accepts.
#LLM_AGENT_TEMPERATURE=
#LLM_CLASSIFY_TEMPERATURE=
#LLM_EXTRACT_TEMPERATURE=
#LLM_JUDGE_TEMPERATURE=

LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_MS=500
LLM_RETRY_MAX_DELAY_MS=20000

# Prices for the llm_usage cost meter, in USD per million tokens. An unpriced
# model meters its tokens with a null cost rather than a wrong one.
#LLM_PRICING_JSON={"claude-sonnet-5":{"inputPerMTokUsd":3,"outputPerMTokUsd":15}}

# ───────────────────────────── observability ───────────────────────────
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_SERVICE_NAME=serviceloop-api

# ──────────────────────── workers / outbox tuning ──────────────────────
WORKER_CONCURRENCY=5
OUTBOX_BATCH_SIZE=100
OUTBOX_IDLE_BACKOFF_MS=250
OUTBOX_MAX_ATTEMPTS=5
QUEUE_MAX_ATTEMPTS=5

DEFAULT_TIMEZONE=Asia/Kolkata

# ─────────────────────────── speech (phase 4.1) ────────────────────────
# DEMO_MODE forces the mock adapter, which transcribes from registered
# fixtures with no credential and no network. CI runs on it.
SPEECH_DRIVER=mock

# Sarvam is the primary: it is trained on Indian code-mixed speech and on
# 8 kHz telephone-grade audio, which is what a WhatsApp voice note recorded
# next to an impact wrench actually is.
#SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3

# Google Cloud Speech-to-Text v2 is the configured fallback. Both the
# recogniser resource *and* a token are required before the boot log will
# report a fallback as available — one without the other is a fallback that
# would fail on its first call.
#GOOGLE_SPEECH_RECOGNIZER=projects/my-project/locations/asia-south1/recognizers/workshop
GOOGLE_SPEECH_BASE_URL=https://speech.googleapis.com
GOOGLE_SPEECH_MODEL=latest_long
# Ordered: the first is primary, the rest are alternates it may switch to.
GOOGLE_SPEECH_LANGUAGES=en-IN,ta-IN,hi-IN
# A pre-minted OAuth token. Deliberately not a service-account key file:
# minting tokens is the deployment's job (workload identity on Cloud Run),
# and a JSON key in an env var is the credential most likely to reach a log.
#GOOGLE_SPEECH_ACCESS_TOKEN=

SPEECH_TIMEOUT_MS=30000
SPEECH_MAX_BYTES=10485760
# Consecutive *provider* failures before traffic moves. A bad recording does
# not count — see `countsTowardsFailover`.
SPEECH_FAILOVER_THRESHOLD=2
SPEECH_FAILOVER_PROBE_MS=300000

# ────────────────────────── payments (phase 4.9) ───────────────────────
# The mock adapter is a real adapter: it mints links, keeps a ledger, and
# signs webhook payloads in Razorpay's own envelope shape, so the whole
# reconcile path runs in CI with no Razorpay account in existence.
# It is refused in production, where it would settle cards without
# collecting anything.
PAYMENTS_DRIVER=mock
#RAZORPAY_KEY_ID=
#RAZORPAY_KEY_SECRET=
# Verifies X-Razorpay-Signature over the *raw* webhook body.
#RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
PAYMENTS_TIMEOUT_MS=20000

# ────────────────────────── gate pass (phase 4.10) ─────────────────────
# Separate from JWT_SECRET on purpose: a gate pass is a bearer capability a
# customer forwards to whoever collects the car, and it must not be signed
# with the key that mints staff sessions. Rotating one must not invalidate
# the other. The development placeholder is refused in production.
GATE_PASS_SECRET=dev-only-gate-pass-secret-change-me-0123456789

# ──────────────────────────── voice (phase 5) ──────────────────────────
# The whole phase is developed and demoed through the browser softphone in
# the console. `loopback` is a complete adapter, not a demo mode: it ships
# the real lifecycle, real typed DTMF events, real barge-in and a real
# recording, behind the same `TelephonyPort` Exotel and Twilio implement.
# DEMO_MODE forces it, so a developer with an Exotel token in their shell
# cannot ring a real customer by clicking a button.
TELEPHONY_DRIVER=loopback
# E.164, and required for either live driver. The number a customer sees.
#TELEPHONY_CALLER_ID=+911140000000
# Where the provider posts call status and opens its media stream. Falls
# back to API_BASE_URL.
#TELEPHONY_WEBHOOK_BASE_URL=
# Verifies the provider's webhook signature. Required for a live driver:
# an unauthenticated call webhook is a way to make the agent phone anybody.
#TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_TIMEOUT_MS=15000

# Exotel is primary for India: DLT-clean voice on Indian numbers.
#EXOTEL_ACCOUNT_SID=
#EXOTEL_API_KEY=
#EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
#EXOTEL_FLOW_APP_ID=

# Twilio is the documented alternative behind the identical contract.
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
TWILIO_BASE_URL=https://api.twilio.com

# Streaming speech. The mock encodes each phrase *into* the audio it makes
# and decodes it back out, so a whole call runs in CI with no credential and
# no network — and with nothing taking a shortcut around the port.
SPEECH_STREAM_DRIVER=mock
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_VOICE_TA=anushka
SARVAM_TTS_VOICE_HI=anushka
SARVAM_TTS_VOICE_EN=anushka
#GOOGLE_STREAM_RECOGNIZER=
# 20 ms is what every telco stack emits.
VOICE_FRAME_MS=20
# How fast the loopback plays queued audio. One is real time, which is what
# a demo somebody is listening to needs; CI turns it up so a nine-turn call
# runs in under a second. Ignored by the live adapters.
VOICE_LOOPBACK_PLAYBACK_SPEED=1

# The platform's brake, above any shop's own setting. True reverts every
# VOICE_OR_ADVISOR rung to an advisor task and refuses new originations —
# without a deploy, which is the entire point of it.
VOICE_KILL_SWITCH=false

# Speech-end to speech-start. Breaching it fills the line with a comfort
# clip; it never ends the call.
VOICE_LATENCY_BUDGET_MS=1200
# Silence after a final transcript that ends the caller's turn. A final is
# not the end of a turn — people pause mid-sentence.
VOICE_ENDPOINT_SILENCE_MS=700
# Longest the line may be silent before the filler plays. Three seconds of
# nothing on a phone is a call the customer assumes has dropped.
VOICE_MAX_DEAD_AIR_MS=3000
VOICE_BARGE_IN_CUTOFF_MS=300
VOICE_MAX_TURNS=12
VOICE_MAX_CALL_SECONDS=240
# One retry on no-answer, then the ladder falls to a person.
VOICE_RETRY_AFTER_MINUTES=20
VOICE_RECORDING_RETENTION_DAYS=180

# Estimates, not invoices. The authoritative figure arrives weeks later and
# the cap has to decide *now* whether this shop may place another call.
VOICE_TELCO_PAISE_PER_MINUTE=60
VOICE_STT_PAISE_PER_MINUTE=50
VOICE_TTS_PAISE_PER_MINUTE=80
VOICE_PLATFORM_DAILY_CAP_PAISE=500000
# Alert before halting, never halt without having alerted: an owner should
# hear from the system while there is still budget to decide what to do with.
VOICE_COST_ALERT_RATIO=0.8

# ───────────── retention, digest & analytics (phase 6) ─────────────
# Everything that decides *whether* a customer is written to lives in the
# shop's own guardrail document (autonomy, consent, the 21-day floor between
# touches, the digest time, the alert thresholds), not here. What is here is
# only how often the workers process looks.
#
# Slower than the phase-4 sentinels on purpose: retention is measured in weeks,
# and scanning every minute for a horizon that passed this morning spends a
# database pass a minute to move a message forward by seconds.
RETENTION_SCAN_MS=900000
RETENTION_BATCH_SIZE=50
FEEDBACK_SCAN_MS=900000
# Tighter, because a stuck approval is an exception an owner is waiting on.
ALERT_SCAN_MS=120000
# The nightly fold and the evening brief. This is what decides how close to the
# shop's configured digest time the brief actually lands.
DIGEST_SCAN_MS=300000
