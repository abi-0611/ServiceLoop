# The console (phase 7.7).
#
# Separate from the Node services because Next.js builds differently and
# deploys differently: it scales to zero (nobody is looking at a board at 3am),
# it holds no queue and no connection pool, and its `standalone` output is a
# self-contained server that must not be assembled the way the API's is.
#
#   docker build -f infra/docker/Dockerfile.console -t serviceloop-console .

FROM node:22.13.0-bookworm-slim AS deps
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/workers/package.json apps/workers/
COPY apps/console/package.json apps/console/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/domain/package.json packages/domain/
COPY packages/adapters/package.json packages/adapters/
COPY packages/agent-core/package.json packages/agent-core/
COPY packages/db/package.json packages/db/
COPY packages/observability/package.json packages/observability/
COPY packages/simulator/package.json packages/simulator/

RUN pnpm install --frozen-lockfile

FROM deps AS build
WORKDIR /app
COPY . .

# `output: 'standalone'` in next.config traces exactly the files the server
# needs and copies them into `.next/standalone`. Without it the runtime image
# carries the whole monorepo's `node_modules`, which for a Next app is close to
# a gigabyte.
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm turbo run build --filter=@serviceloop/console

# Distroless, same reasoning as the API. Next's standalone server is plain Node
# with no shell dependency, so nothing is given up.
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS console
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=build --chown=nonroot:nonroot /app/apps/console/.next/standalone ./
COPY --from=build --chown=nonroot:nonroot /app/apps/console/.next/static ./apps/console/.next/static
COPY --from=build --chown=nonroot:nonroot /app/apps/console/public ./apps/console/public

USER nonroot

CMD ["apps/console/server.js"]
