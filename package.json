{
  "name": "serviceloop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\"",
    "db:generate": "pnpm --filter @serviceloop/db run db:generate",
    "db:migrate": "pnpm --filter @serviceloop/db run db:migrate",
    "db:rollback": "pnpm --filter @serviceloop/db run db:rollback",
    "db:seed": "pnpm --filter @serviceloop/db run db:seed",
    "demo:phase1": "pnpm --filter @serviceloop/simulator run demo:phase1",
    "demo:phase2": "pnpm --filter @serviceloop/simulator run demo:phase2",
    "eval:ocr": "pnpm --filter @serviceloop/simulator run eval:ocr",
    "infra:up": "docker compose --project-directory . -f infra/compose.yaml up -d",
    "infra:down": "docker compose --project-directory . -f infra/compose.yaml down",
    "infra:reset": "docker compose --project-directory . -f infra/compose.yaml down -v",
    "sim": "pnpm --filter @serviceloop/simulator run sim",
    "demo:phase3": "pnpm --filter @serviceloop/simulator run demo:phase3",
    "demo:phase4": "pnpm --filter @serviceloop/simulator run demo:phase4",
    "sim:voice": "pnpm --filter @serviceloop/simulator run sim:voice",
    "demo:phase5": "pnpm --filter @serviceloop/simulator run demo:phase5",
    "metrics:recompute": "pnpm --filter @serviceloop/db run metrics:recompute",
    "demo:phase6": "pnpm --filter @serviceloop/simulator run demo:phase6",
    "demo:phase7": "pnpm --filter @serviceloop/simulator run demo:phase7",
    "demo:journey": "pnpm --filter @serviceloop/simulator run demo:journey",
    "audit:verify": "pnpm --filter @serviceloop/db run audit:verify",
    "pii:rotate": "pnpm --filter @serviceloop/db run pii:rotate",
    "dlq:list": "pnpm --filter @serviceloop/workers run dlq:list",
    "dlq:replay": "pnpm --filter @serviceloop/workers run dlq:replay",
    "dlq:drop": "pnpm --filter @serviceloop/workers run dlq:drop",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "lint:templates": "node scripts/lint-templates.mjs",
    "chaos": "node scripts/chaos.mjs",
    "backup": "bash scripts/backup.sh",
    "restore:verify": "bash scripts/restore-and-verify.sh",
    "infra:ops": "docker compose --project-directory . -f infra/compose.yaml --profile ops up -d",
    "perf:webhook": "k6 run perf/webhook-burst.js",
    "perf:conversations": "k6 run perf/concurrent-conversations.js",
    "perf:board": "k6 run perf/console-board.js"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "sharp@<0.35.0": "^0.35.4",
      "esbuild@<0.25.0": "^0.25.0",
      "uuid@<11.1.1": "^11.1.1",
      "vite@<6.4.3": "^6.4.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  }
}
