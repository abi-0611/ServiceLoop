{
  "name": "@serviceloop/workers",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint src",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test:unit": "vitest run src",
    "test": "vitest run",
    "test:integration": "vitest run test",
    "dlq:list": "tsx src/cli/dlq.ts list",
    "dlq:replay": "tsx src/cli/dlq.ts replay",
    "dlq:drop": "tsx src/cli/dlq.ts drop"
  },
  "dependencies": {
    "@serviceloop/adapters": "workspace:*",
    "@serviceloop/agent-core": "workspace:*",
    "@serviceloop/config": "workspace:*",
    "@serviceloop/db": "workspace:*",
    "@serviceloop/domain": "workspace:*",
    "@serviceloop/observability": "workspace:^",
    "@serviceloop/shared": "workspace:*",
    "bullmq": "^5.34.5",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
